{
  "//": "Merge this object into ~/.zcode/cli/config.json. Replace <donechan-entry> with the absolute path to DoneChan's dist/cli.js.",
  "hooks": {
    "enabled": true,
    "events": {
      "Stop": [
        {
          "hooks": [
            {
              "type": "process",
              "command": "node",
              "args": ["<donechan-entry>", "hook"],
              "timeoutMs": 8000,
              "statusMessage": "DoneChan：推送完成通知"
            }
          ]
        }
      ]
    }
  }
}
